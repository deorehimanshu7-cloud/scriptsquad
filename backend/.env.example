# AGRIFUR2 backend environment (loaded via dotenv from the backend working dir).
# Copy to backend/.env — or export the same variables from the repository root.

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database mode:
#   postgres   — canonical production: PostgreSQL + PostGIS (all spatial SQL).
#                Start infra:  docker compose up -d postgres
#   sqlite-dev — development fallback ONLY (no Docker/PostGIS available).
#                Labelled everywhere; never claims PostGIS-backed math.
DATABASE_MODE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agrifur2
DB_USER=postgres
DB_PASSWORD=postgres
# DB_FILE=./agrifur2.db        # sqlite-dev only

# JWT
JWT_SECRET=change-this-in-production
JWT_REFRESH_SECRET=change-this-refresh-secret

# AI (OpenAI-compatible API). Without AI_API_KEY the assistant uses the local
# grounded engine that only reasons over stored evidence.
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Voice — AUTH_REQUIRED until set
SPEECH_API_KEY=

# MQTT (IoT transport)
MQTT_BROKER=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Providers (credential-free adapters work out of the box)
OPEN_METEO_ENABLED=true
COPERNICUS_ENABLED=true
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
LANDSAT_ENABLED=true
SOILGRIDS_ENABLED=true
BHOONIDHI_ENABLED=false
BHOONIDHI_CLIENT_ID=
BHOONIDHI_CLIENT_SECRET=
WATER_ENABLED=false

# Seed guard — development seeds only when explicitly set
AGRIFUR2_SEED=production

# ============================================================================
# AGRIFUR2 environment template
# Copy to .env (backend loads it via dotenv) and fill in real values.
# No secret is ever fabricated or committed; providers without credentials
# report AUTH_REQUIRED truthfully and the system keeps running.
# ============================================================================

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Database
#   DATABASE_MODE=postgres   → PostgreSQL + PostGIS (CANONICAL / PRODUCTION).
#                              All spatial math runs in PostGIS
#                              (ST_Area / ST_Perimeter / ST_Centroid /
#                              ST_Intersects / ST_Within / ST_Contains /
#                              ST_DWithin), SRID 4326 + projected CRS.
#   DATABASE_MODE=sqlite-dev → DEVELOPMENT FALLBACK ONLY, clearly labelled.
#                              Geometry metrics come from shared geodesic
#                              utilities and are never claimed as PostGIS.
#                              The API exposes database_mode so the UI can
#                              label results truthfully.
# ---------------------------------------------------------------------------
DATABASE_MODE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agrifur2
DB_USER=postgres
DB_PASSWORD=postgres
# sqlite-dev only (optional): where the fallback DB file lives
# DB_FILE=./agrifur2.db

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
JWT_SECRET=change-this-in-production
JWT_REFRESH_SECRET=change-this-refresh-secret

# ---------------------------------------------------------------------------
# AI Assistant (OpenAI-compatible chat API)
#   Without AI_API_KEY the assistant runs the local grounded engine which only
#   reasons over stored field evidence — it never invents measurements.
# ---------------------------------------------------------------------------
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Voice transcription (OpenAI-compatible speech endpoint)
# Without it /assistant/audio and /assistant/transcribe answer AUTH_REQUIRED.
SPEECH_API_KEY=

# ---------------------------------------------------------------------------
# MQTT (IoT transport only — persistence is PostgreSQL/PostGIS)
# ---------------------------------------------------------------------------
MQTT_BROKER=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ---------------------------------------------------------------------------
# Providers
#   Catalog search (Copernicus STAC / Landsat earth-search / Open-Meteo /
#   SoilGrids / Open-Meteo DEM) is credential-free and works out of the box.
#   Asset/band download and authenticated catalogs need the keys below.
# ---------------------------------------------------------------------------
OPEN_METEO_ENABLED=true
COPERNICUS_ENABLED=true
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
COPERNICUS_STAC_URL=https://stac.dataspace.copernicus.eu/v1
LANDSAT_ENABLED=true
SOILGRIDS_ENABLED=true

# Bhoonidhi / NRSC / ISRO (India) — authenticated catalog
BHOONIDHI_ENABLED=false
BHOONIDHI_CLIENT_ID=
BHOONIDHI_CLIENT_SECRET=

# Water (CGWB groundwater, India-WRIS) — credential-gated national datasets
WATER_ENABLED=false
CGWB_USERNAME=
CGWB_PASSWORD=
INDIA_WRIS_TOKEN=

# ---------------------------------------------------------------------------
# Development seeding — REQUIRES explicit opt-in; seeds are labelled
# DEVELOPMENT_SEED and never mixed silently with production evidence.
# ---------------------------------------------------------------------------
AGRIFUR2_SEED=production

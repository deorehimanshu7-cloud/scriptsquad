# ---------------------------------------------------------------------------
# AGRIFUR — environment variables
# ---------------------------------------------------------------------------
# Copy to `.env` for local development. Never commit a real `.env`.
#
# SERVER-ONLY / SECRET — never expose these to browsers.
# The frontend is a same-origin SPA: it calls `/api/*` on the host serving it
# and reads NO environment variables of its own.

# --- Core server ---
# HTTP port the API + SPA server listens on (default 8787).
PORT=8787
# SQLite database file (development default; production should point at
# persistent storage). The schema auto-migrates on boot.
DATABASE_PATH=./data/agrifur.db
# Directory of the built frontend served by the API (default apps/web/dist).
WEB_DIST_DIR=./apps/web/dist
# Allowed CORS origin(s) as a comma-separated list, or empty for same-origin.
WEB_ORIGIN=
# Public base URL used in links/emails (optional).
PUBLIC_BASE_URL=

# --- Accounts ---
# Comma-separated allow-list of emails that may register (empty = open).
ALLOWED_REGISTER_EMAILS=
# Label for the DEVELOPMENT-SEED demo account (never used in production).
DEMO_EMAIL=demo@agrifur.dev
# Auto-create the labelled demo account on a FRESH database (dev only).
SEED_DEMO_ON_BOOT=0

# --- LLM (grounded AI assistant) — optional ---
# Without a key the assistant answers in grounded local-fallback mode.
LLM_API_KEY=
# OpenAI-compatible base URL, e.g. https://generativelanguage.googleapis.com/v1beta/openai/
LLM_BASE_URL=
LLM_MODEL=gemini-2.0-flash

# --- Earth observation (Copernicus Data Space) ---
# Anonymous STAC metadata discovery works without credentials.
# Raster/preview access requires OAuth client credentials (free account).
COPERNICUS_STAC_URL=https://stac.dataspace.copernicus.eu/v1
COPERNICUS_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# --- Weather / terrain / soil (keyless public services; override to test) ---
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPENTOPODATA_BASE_URL=https://api.opentopodata.org/v1
SOILGRIDS_BASE_URL=https://maps.isric.org/mapserv

# --- Indian Earth-observation portals (optional, account-gated) ---
BHOONIDHI_API_URL=
BHOONIDHI_CLIENT_ID=
BHOONIDHI_CLIENT_SECRET=
BHOONIDHI_TOKEN_URL=

# --- Voice bot (separate Python service in voicebot/) ---
# The existing SarvamAI voice bot stays the voice engine (STT/AI/TTS); these
# vars connect it to AGRIFUR so answers are grounded on real field evidence.
# All are server-side in the Python process — never in browser code.
SARVAM_API_SUBSCRIPTION_KEY=
AGRIFUR_AI_CONTEXT_URL=
AGRIFUR_TOKEN=
AGRIFUR_DEFAULT_FIELD_ID=
VOICE_PORT=7860
VOICE_SHARE=0
# Non-secret: URL of the running voice-bot UI (e.g. http://192.168.1.44:7860).
# When set, the /app/voice page embeds the bot for the selected field.
VITE_VOICE_BOT_URL=

# --- MQTT (physical sensor bridge) ---
# The backend subscribes to a broker that is reachable from the server.
# Leave empty to report mqtt-broker = NOT_CONFIGURED truthfully.
MQTT_ENABLED=0
MQTT_BROKER_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=AGRIFUR

# --- Hardware gateway (REAL ESP32 over HTTPS, production) ---
# Server-side shared key the device sends as x-device-key to
# POST /api/hardware/telemetry. Devices must be registered on their field
# first (Sensors workspace). Route answers 503 until this is set; serve the
# API behind a public HTTPS endpoint and never expose this over plain HTTP
# outside a trusted LAN. Rotate like any secret.
HARDWARE_GATEWAY_TOKEN=

# --- DEV hardware HTTP ingestion (DEVELOPMENT ONLY) ---
# Simplest real-ESP32 path: POST /api/dev/hardware/telemetry (no MQTT, no
# session). NEVER enable on a public host. When DEV_TELEMETRY_TOKEN is set,
# devices must send it in the x-device-key header. Defaults: disabled, no key.
DEV_TELEMETRY_ENABLED=0
DEV_TELEMETRY_TOKEN=
